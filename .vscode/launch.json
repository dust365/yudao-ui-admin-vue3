{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Vite (Local)",
      "preLaunchTask": "install-dependencies",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev-server"],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "http://localhost:(\\d+)"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Vite (Dev)",
      "preLaunchTask": "install-dependencies",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev-server"],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "http://localhost:(\\d+)"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Vite (Prod)",
      "preLaunchTask": "install-dependencies",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "prod-server"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}